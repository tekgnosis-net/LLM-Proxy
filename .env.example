# LiteLLM master key — gates all admin endpoints AND is the UI admin password.
# Generate with: echo "sk-$(openssl rand -hex 32)"
LITELLM_MASTER_KEY=sk-CHANGEME-generate-a-real-one

# Salt key — encrypts provider API keys stored in Postgres.
# WARNING: cannot be rotated without re-entering every stored provider key.
# Back this value up.
# Generate with: echo "sk-$(openssl rand -hex 32)"
LITELLM_SALT_KEY=sk-CHANGEME-generate-a-real-one

# Postgres credentials. Used only on the internal compose network — Postgres
# is not exposed to the host.
POSTGRES_USER=litellm
POSTGRES_PASSWORD=CHANGEME-pick-a-strong-password

# Admin UI
UI_PORT=8081
# argon2 hash of the admin password — generate after building the image:
#   docker compose run --rm --no-deps llm-proxy-ui python -c "from app.auth import hash_password; print(hash_password('YOUR_PASSWORD'))"
ADMIN_PASSWORD_HASH=
# random secret for signing session cookies (openssl rand -hex 32)
SESSION_SECRET=
