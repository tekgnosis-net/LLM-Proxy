# LiteLLM proxy bootstrap — the SINGLE SOURCE OF TRUTH for models, routing, and
# caching. store_model_in_db is OFF, so this file is authoritative. The admin UI
# (llm-proxy-ui) reads/writes this file, validates it, and applies changes by
# restarting the proxy (~25s; SIGHUP is a no-op on this image) with health-verify
# + auto-rollback. Virtual keys, budgets, and spend live in Postgres and are managed
# through the proxy API (NOT here).

general_settings:
  master_key: os.environ/LITELLM_MASTER_KEY
  database_url: os.environ/DATABASE_URL   # keys / budgets / spend only (not models)
  store_model_in_db: false                # config.yaml wins; no DB override
  background_health_checks: true          # cache per-model health for the UI's health column
  health_check_interval: 300              # seconds between background health checks

litellm_settings:
  drop_params: true
  telemetry: false
  cache: true
  cache_params:
    # The UI writes this and NEVER emits an `ssl` key. Don't add one by hand:
    # LiteLLM bug #10949 makes any `ssl` key (even ssl: false) use an SSL
    # connection -> TLS handshake against plain Valkey hangs ->
    # "Timeout connecting to server".
    type: redis
    host: os.environ/REDIS_HOST
    port: os.environ/REDIS_PORT

# Routing lives HERE now (config-only). The UI's Routing screen edits this block.
# Valid routing_strategy values: simple-shuffle, least-busy, usage-based-routing,
# usage-based-routing-v2, latency-based-routing, cost-based-routing
# (NOT "lowest-cost" — that's only a docs nickname and LiteLLM rejects it).
router_settings:
  routing_strategy: simple-shuffle
  redis_host: os.environ/REDIS_HOST     # routing-state sharing for cost/usage/latency strategies (Valkey)
  redis_port: os.environ/REDIS_PORT

# Models — managed by the UI's Models screen (written here). Empty until you add
# deployments; each entry is {model_name, litellm_params: {model, ...}}.
model_list: []
